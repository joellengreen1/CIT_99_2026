    "import numpy as np\n",
    "L = pd.Series([16366,\t16014, 2600, 10500,\t2741])\n",
    "meanx = L.mean().item()\n",
    "stdx = L.std().item()\n",
    "print(\"coefficient of variation percentage\", np.round(100 * stdx/meanx, 2))"
   ]
